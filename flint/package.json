{
  "name": "flint-lsp",
  "displayName": "Flint Language Server",
  "description": "Syntax highlighting and Language Server support for the Flint programming language",
  "version": "0.4.0",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "publisher": "zweiler1",
  "repository": {
    "type": "git",
    "url": "https://github.com/flint-lang/vscode-extension"
  },
  "icon": "logo.png",
  "activationEvents": [
    "onLanguage:flint",
    "onDebug",
    "onDebugResolve:flint"
  ],
  "main": "./src/extension.js",
  "dependencies": {
    "vsce": "^1.90.0",
    "vscode-languageclient": "^9.0.0"
  },
  "contributes": {
    "configuration": {
      "title": "Flint",
      "properties": {
        "flint.languageServer.path": {
          "type": "string",
          "default": "fls",
          "description": "Path to the Flint Language Server executable"
        },
        "flint.languageServer.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Flint Language Server"
        },
        "flint.debugAdapter.path": {
          "type": "string",
          "default": "lldb-dap",
          "description": "Path to the lldb-dap executable used for debugging Flint programs"
        }
      },
      "configurationDefaults": {
        "[flint]": {
          "editor.insertSpaces": false,
          "editor.tabSize": 4
        }
      }
    },
    "languages": [
      {
        "id": "flint",
        "aliases": [
          "Flint",
          "flint"
        ],
        "extensions": [
          ".ft"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "dark": "./icons/flint.svg",
          "light": "./icons/flint.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "flint",
        "scopeName": "source.flint",
        "path": "./syntaxes/flint.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "Flint Theme",
        "uiTheme": "vs-dark",
        "path": "./themes/flint-color-theme.json"
      }
    ],
    "breakpoints": [
      { "language": "flint" }
    ],
    "debuggers": [
      {
        "type": "flint",
        "label": "Flint Debugger",
        "languages": ["flint"],
        "configurationAttributes": {
          "launch": {
            "required": ["program"],
            "properties": {
              "program": {
                "type": "string",
                "description": "Path to the compiled Flint executable"
              },
              "args": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Command-line arguments passed to the program"
              },
              "cwd": {
                "type": "string",
                "description": "Working directory for the debugged program"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Break immediately when the program starts"
              },
              "sourcePath": {
                "type": "string",
                "description": "Root path for resolving relative source paths in debug info"
              },
              "debuggerRoot": {
                "type": "string",
                "description": "Working directory for lldb-dap"
              },
              "sourceMap": {
                "type": "array",
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": { "type": "string" }
                },
                "description": "Source path mappings from compile-time to local paths: [[\"/build/path\", \"/local/path\"]]"
              },
              "initCommands": {
                "type": "array",
                "items": { "type": "string" },
                "description": "LLDB commands executed on startup"
              }
            }
          }
        },
        "configurationSnippets": [
          {
            "label": "Flint: Launch",
            "body": {
              "type": "flint",
              "request": "launch",
              "name": "Launch Flint Program",
              "program": "${command:flint.debugAskForProgram}",
              "args": [],
              "cwd": "${workspaceFolder}",
              "stopOnEntry": true
            }
          }
        ],
        "adapterExecutableCommand": "flint.debugAdapterExecutable"
      }
    ]
  }
}
